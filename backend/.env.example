# Groq API Key for the LangGraph assistant
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (supported: qwen/qwen3.8-27b or openai/gpt-oss-20b)
GROQ_MODEL=qwen/qwen3.8-27b

# Host and Port configuration
PORT=8000
HOST=127.0.0.1

# Allowed Frontend Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://opsmate-ai.vercel.app
